# names only, never values
NODE_ENV=development
DATABASE_URL=
DATABASE_URL_MIGRATE=
SESSION_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=owner/repo-name
SEED_PASSWORD=

# Development and Preview use Cloudflare's official test keys when these are empty.
# Set your own matching keys in production. Only the site key is sent to the browser.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional comma-separated allowed widget hostnames for server-side checks.
TURNSTILE_HOSTNAMES=